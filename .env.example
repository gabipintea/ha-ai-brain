# ============================================================================
# HA AI Brain — Local Development & Testing Environment (.env)
# (When running inside Home Assistant OS as an Add-on, this is 100% automated)
# ============================================================================

# 1. Home Assistant Connection (Local Workstation Dev)
# In HA OS Add-on mode, SUPERVISOR_TOKEN auto-connects to http://supervisor/core.
BRAIN_HA_URL=http://homeassistant.local:8123
BRAIN_HA_WS_URL=ws://homeassistant.local:8123/api/websocket
BRAIN_HA_TOKEN=your_long_lived_access_token_here
BRAIN_USE_SIMULATOR=false

# 2. Operating Mode & Safety Autonomy
# Modes: realtime_stream | periodic_batch | hybrid
BRAIN_OPERATING_MODE=hybrid
# Autonomy: shadow (observe only) | copilot (ask approval before acting) | autonomous
BRAIN_DEFAULT_AUTONOMY=copilot

# 3. AI Model Provider (LiteLLM Format)
# Supports:
# - Google Gemini: gemini/gemini-3.8-flash (or gemini/gemini-3.5-flash)
# - OpenAI: openai/gpt-4o
# - Anthropic: anthropic/claude-3-5-sonnet-20241022
# - OpenRouter: openrouter/anthropic/claude-3.5-sonnet
# - Local Ollama: ollama/llama3.2
BRAIN_LLM_MODEL=gemini/gemini-3.8-flash
BRAIN_LLM_FAST_MODEL=gemini/gemini-3.5-flash
BRAIN_LLM_API_KEY=

# 4. Notifications & Memory
BRAIN_NOTIFICATIONS_ENABLED=true
BRAIN_NOTIFICATION_SERVICE=notify.notify
BRAIN_BATCH_INTERVAL_MINUTES=360
# Local runs: relative path. (docker-compose overrides this with /data/ha_ai_brain.db)
BRAIN_DB_PATH=data/ha_ai_brain.db

# 5. Site & Building Context
# Free-form description of the property (rooms, heating type, occupancy habits). Leave empty for auto-discovery.
BRAIN_SITE_CONTEXT=""

# 6. Learning & safety (all optional; defaults shown)
# BRAIN_TIMEZONE=Europe/Berlin          # auto-discovered from Home Assistant when empty
# BRAIN_REALTIME_GATING=true            # wake the AI only for unusual events once routines are learned
# BRAIN_EXCEPTION_DETECTION=true
# BRAIN_DETERMINISTIC_AUTOMATIONS=true  # propose automations for strong habits without any AI call
# BRAIN_BASELINE_MIN_DAYS=3
# BRAIN_STORE_BACKFILL_HOURS=240        # recorder history imported at startup
# BRAIN_HISTORY_MAX_ENTITIES=300
# BRAIN_DAILY_TOKEN_BUDGET=0            # 0 = unlimited
# BRAIN_MAX_ACTIONS_PER_HOUR=30
# BRAIN_QUIET_HOURS_START=22:30
# BRAIN_QUIET_HOURS_END=07:00
# BRAIN_PRIVACY_SCRUB=true
# BRAIN_KNOWLEDGE_DIR=./data/knowledge  # extra expert reference files (*.yaml)
# BRAIN_RESEARCH_ENABLED=true           # weekly expert research per agent, any AI provider; you approve findings
# BRAIN_RESEARCH_WEB_SEARCH=false       # optional deep research with cited sources (Gemini only, more tokens)
# BRAIN_RESEARCH_INTERVAL_DAYS=7
# BRAIN_RESEARCH_TOPICS_PER_AGENT=1
# BRAIN_MAX_EXCEPTIONS_PER_CYCLE=5      # new unusual-situation alerts per 5-minute check
# BRAIN_MAX_EXCEPTIONS_PER_DAY=20       # non-critical alerts per day (critical ones are never capped)
