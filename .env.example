# ============================================================================
# HA AI Brain — Real Home Assistant Connection Settings
# Copy to `.env` or export in shell before running
# ============================================================================

# 1. Home Assistant URL & Long-Lived Access Token
# (Not needed when running as an HA OS Add-on, which auto-uses SUPERVISOR_TOKEN)
BRAIN_HA_URL=http://homeassistant.local:8123
BRAIN_HA_WS_URL=ws://homeassistant.local:8123/api/websocket
BRAIN_HA_TOKEN=your_long_lived_access_token_here
BRAIN_USE_SIMULATOR=false

# 2. Operating Mode & Safety Autonomy Level
# Modes: realtime_stream | periodic_batch | hybrid
BRAIN_OPERATING_MODE=hybrid
# Autonomy: shadow (observe & log only) | copilot (ask approval) | autonomous
BRAIN_DEFAULT_AUTONOMY=shadow

# 3. LLM Provider (LiteLLM format: openai/gpt-4o, anthropic/claude-3-5-sonnet-latest, gemini/gemini-2.0-flash, ollama/llama3.1)
BRAIN_LLM_MODEL=openai/gpt-4o
BRAIN_LLM_FAST_MODEL=openai/gpt-4o-mini
BRAIN_LLM_API_KEY=

# 4. Notifications & Batch Interval
BRAIN_NOTIFICATIONS_ENABLED=true
BRAIN_NOTIFICATION_SERVICE=notify.notify
BRAIN_BATCH_INTERVAL_MINUTES=360
